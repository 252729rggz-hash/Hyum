# ───────────────────────────────────────────────
# mens-mall-agents 환경 변수 예시
# cp .env.example .env 후 값을 채워 넣으세요.
# ───────────────────────────────────────────────

# 앱
APP_NAME=mens-mall-agents
APP_ENV=local                 # local | dev | prod
LOG_LEVEL=INFO

# ── LLM ──────────────────────────────────────
# mock 으로 두면 API 키 없이 고정 규칙 기반 결과로 전체 흐름을 테스트할 수 있습니다.
LLM_PROVIDER=mock             # mock | openai | anthropic
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── 저장소 ────────────────────────────────────
DATABASE_URL=postgresql+psycopg://mall:mall@localhost:5432/mall
REDIS_URL=redis://localhost:6379/0

# ── 쇼핑몰 연동 ───────────────────────────────
MALL_PLATFORM=custom          # cafe24 | imweb | custom
MALL_API_BASE_URL=https://mall.example.com/api
MALL_SHOP_ID=
MALL_API_KEY=
MALL_CLIENT_ID=
MALL_CLIENT_SECRET=

# ── 운영 / 승인 ───────────────────────────────
# 승인 요청 알림을 받을 웹훅(슬랙/카톡/자체 알림 서버). 비워두면 로그로만 남깁니다.
APPROVAL_WEBHOOK_URL=
APPROVAL_TIMEOUT_HOURS=24

# 검수 반려 시 최대 재작업 횟수
QA_MAX_REVISIONS=2

# 가격 계산 기본값
DEFAULT_TARGET_MARGIN_RATE=0.55
PLATFORM_FEE_RATE=0.035
# PG 결제 수수료율(결제액 기준). 판매가에서 차감됩니다.
PAYMENT_FEE_RATE=0.018
# 반품·불량 충당금 비율(판매가 기준). 5~10% 사이 권장.
RETURN_RESERVE_RATE=0.05
DEFAULT_SHIPPING_FEE=3000
VAT_RATE=0.1
# 월 고정비(광고·툴) — 손익분기 수량 계산에만 사용
MONTHLY_FIXED_COST=0
# 예상 판매량 대비 초도 사입 배수
INITIAL_ORDER_MULTIPLIER=1.6
